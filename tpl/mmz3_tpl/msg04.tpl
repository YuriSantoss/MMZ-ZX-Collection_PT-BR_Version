@archive msg04
@size 6

script 0 mmz3 {
    mugshotShow
        mugshot = 100
    """
    Operadora:
    Foi detectada
    uma forte leitura
    """
    msgClear
    """
    de energia.
    """
    msgClear
    """
    Estao construindo
    um enorme missel
    fora da base.
    """
    msgClear
    """
    A base deve estar
    aqui para apoiar a
    construcao.
    """
    msgClear
    """
    Ciel:
    Analisar uma rota
    ate a fabrica
    """
    msgClear
    """
    de misseis
    levara bastante
    tempo...
    """
    msgClear
    """
    Zero, o que
    deveriamos fazer?
    """
    msgClear
    mugshotShow
        mugshot = 4
    """
    Muito bem. Ganharei
    algum tempo
    atacando a base.
    """
    msgClear
    """
    Comece a
    analise!
    """
    end
}
script 2 mmz3 {
    mugshotShow
        mugshot = 23
